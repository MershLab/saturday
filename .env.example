# --- pick ONE provider block (set SATURDAY_PROVIDER too) ---

DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
NOUS_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
ZAI_API_KEY=
TOGETHER_API_KEY=

# Qwen (DashScope): the intl endpoint pairs with International keys; China
# mainland keys need DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=

# Azure OpenAI: resource endpoint + deployment name (= model) + api-version.
# Docs: https://<resource>.openai.azure.com/openai/deployments/<deployment>/chat/completions?api-version=...
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=https://myres.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_MODEL=my-deployment

# local / self-hosted
OLLAMA_API_KEY=
VLLM_API_KEY=
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=

SATURDAY_PROVIDER=deepseek
SATURDAY_MODEL=deepseek-reasoner
SATURDAY_MAX_STEPS=40
SATURDAY_WORKSPACE=.
